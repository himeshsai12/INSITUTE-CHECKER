# Copy this file to .env. Demo mode needs no API keys.
# Never paste real keys into the chat or commit .env.
# Choose auto, openai, gemini, anthropic, groq or openrouter.
# Auto selects the first configured provider in that order.
AI_PROVIDER=auto
# Tavily discovers live sources for any AI provider. OpenAI also works alone.
TAVILY_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_MODEL=claude-haiku-5-5
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=google/gemini-2.5-flash
# Search results stay cached on disk for this many hours.
RESEARCH_CACHE_HOURS=24
# Count every outbound attempt, including retries, across the local workspace.
DAILY_API_REQUEST_LIMIT=30
OPENAI_MAX_OUTPUT_TOKENS=2400
API_TIMEOUT_SECONDS=45
# Optional absolute path; default is data/intelligence.db in this project.
IIP_DATABASE_PATH=
